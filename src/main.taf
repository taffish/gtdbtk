<taf-app:container:ghcr.io/taffish/gtdbtk:2.7.2-r1$@[docker/podman: --platform linux/amd64][docker/podman: $(taf_gtdbtk_auto="${TAFFISH_GTDBTK_AUTO_MOUNT:-1}"; if test "$taf_gtdbtk_auto" = 0 || test "$taf_gtdbtk_auto" = false || test "$taf_gtdbtk_auto" = FALSE || test "$taf_gtdbtk_auto" = no || test "$taf_gtdbtk_auto" = NO || test "$taf_gtdbtk_auto" = off || test "$taf_gtdbtk_auto" = OFF; then exit 0; fi; taf_gtdbtk_db="${TAFFISH_GTDBTK_DATA_PATH:-}"; taf_gtdbtk_explicit=0; if test -n "$taf_gtdbtk_db"; then taf_gtdbtk_explicit=1; else for taf_gtdbtk_candidate in "${HOME}/.local/share/taffish/databases/gtdbtk/r232" "/usr/local/share/taffish/databases/gtdbtk/r232" "/opt/taffish/databases/gtdbtk/r232"; do if test -d "$taf_gtdbtk_candidate"; then taf_gtdbtk_db="$taf_gtdbtk_candidate"; break; fi; done; fi; if test -n "$taf_gtdbtk_db" && test -d "$taf_gtdbtk_db"; then taf_gtdbtk_db="$(cd "$taf_gtdbtk_db" 2>/dev/null && pwd -P)"; printf -- '--volume=%s:/refdata:ro' "$taf_gtdbtk_db"; elif test "$taf_gtdbtk_explicit" = 1; then printf >&2 'taf-gtdbtk: TAFFISH_GTDBTK_DATA_PATH does not exist or is not a directory: %s\n' "$taf_gtdbtk_db"; fi)][apptainer: $(taf_gtdbtk_auto="${TAFFISH_GTDBTK_AUTO_MOUNT:-1}"; if test "$taf_gtdbtk_auto" = 0 || test "$taf_gtdbtk_auto" = false || test "$taf_gtdbtk_auto" = FALSE || test "$taf_gtdbtk_auto" = no || test "$taf_gtdbtk_auto" = NO || test "$taf_gtdbtk_auto" = off || test "$taf_gtdbtk_auto" = OFF; then exit 0; fi; taf_gtdbtk_db="${TAFFISH_GTDBTK_DATA_PATH:-}"; taf_gtdbtk_explicit=0; if test -n "$taf_gtdbtk_db"; then taf_gtdbtk_explicit=1; else for taf_gtdbtk_candidate in "${HOME}/.local/share/taffish/databases/gtdbtk/r232" "/usr/local/share/taffish/databases/gtdbtk/r232" "/opt/taffish/databases/gtdbtk/r232"; do if test -d "$taf_gtdbtk_candidate"; then taf_gtdbtk_db="$taf_gtdbtk_candidate"; break; fi; done; fi; if test -n "$taf_gtdbtk_db" && test -d "$taf_gtdbtk_db"; then taf_gtdbtk_db="$(cd "$taf_gtdbtk_db" 2>/dev/null && pwd -P)"; printf -- '--bind=%s:/refdata:ro --env=GTDBTK_DATA_PATH=/refdata/' "$taf_gtdbtk_db"; elif test "$taf_gtdbtk_explicit" = 1; then printf >&2 'taf-gtdbtk: TAFFISH_GTDBTK_DATA_PATH does not exist or is not a directory: %s\n' "$taf_gtdbtk_db"; fi)]>
gtdbtk ::*ARGV*::
