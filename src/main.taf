<taf-app:container:ghcr.io/taffish/gtdbtk:2.8.0-r1$@[docker/podman: --platform linux/amd64 $(taf_g_fail() { printf >&2 'taf-gtdbtk: %s\n' "$1"; printf -- '--taffish-gtdbtk-invalid-db'; exit 0; }; taf_g_auto="${TAFFISH_GTDBTK_AUTO_MOUNT:-1}"; test "$taf_g_auto" != 0 || exit 0; test "$taf_g_auto" = 1 || taf_g_fail 'TAFFISH_GTDBTK_AUTO_MOUNT must be 0 or 1'; taf_g_root="${TAFFISH_GTDBTK_DATA_PATH:-}"; if test "${TAFFISH_GTDBTK_DATA_PATH+x}" != x; then for taf_g_try in "${HOME:-}/.local/share/taffish/databases/gtdbtk/r232" /usr/local/share/taffish/databases/gtdbtk/r232 /opt/taffish/databases/gtdbtk/r232; do if test -e "$taf_g_try" || test -L "$taf_g_try"; then taf_g_root="$taf_g_try"; break; fi; done; fi; if test -z "$taf_g_root" && test "${TAFFISH_GTDBTK_DATA_PATH+x}" != x; then exit 0; fi; test -n "$taf_g_root" && test -d "$taf_g_root" || taf_g_fail 'missing database root; choose a prepared TAFFISH_GTDBTK_DATA_PATH'; taf_g_root="$(cd "$taf_g_root" && pwd -P)" || taf_g_fail 'cannot resolve database root'; test "$(printf '%s' "$taf_g_root" | tr -d ' \011\012\013\014\015\052\054\072\077\133\135')" = "$taf_g_root" || taf_g_fail 'bind path contains whitespace/reserved characters; use manual bind'; for taf_g_name in taffish-resource.json taffish-resource.files taffish-resource.ready; do test -s "$taf_g_root/$taf_g_name" && test ! -L "$taf_g_root/$taf_g_name" || taf_g_fail 'missing manifest/inventory/READY'; done; taf_g_hash() { if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1"; else shasum -a 256 "$1"; fi; }; taf_g_a="$(taf_g_hash "$taf_g_root/taffish-resource.json")" || taf_g_fail 'SHA256 tool failed'; taf_g_b="$(taf_g_hash "$taf_g_root/taffish-resource.files")" || taf_g_fail 'SHA256 tool failed'; test "${taf_g_a%% *} ${taf_g_b%% *}" = "$(cat "$taf_g_root/taffish-resource.ready")" || taf_g_fail 'READY checksum mismatch'; grep -F '"md5": "25a59e0352b1fd150c589f56559767d4"' "$taf_g_root/taffish-resource.json" >/dev/null || taf_g_fail 'wrong R232 identity'; test -z "$(find "$taf_g_root" -type l -print)" || taf_g_fail 'resource contains a symlink'; test -z "$(find "$taf_g_root" -perm -002 -o -perm -020)" || taf_g_fail 'resource must not be group/world writable'; find "$taf_g_root" -type f -exec ls -ln {} + | LC_ALL=C awk -v prefix="$taf_g_root/" "$(printf '%b' 'FILENAME != "-" { if (NF != 2 || $1 !~ /^\1330-9\135+$/ || $2 ~ /^\\// || $2 ~ /\\.\\./ || $2 !~ /^\133A-Za-z0-9_.+\\/-\135+$/ || ($2 in expected)) bad=1; expected\133$2\135=$1; count++; next } { name=substr($NF,length(prefix)+1); if (name=="taffish-resource.json" || name=="taffish-resource.files" || name=="taffish-resource.ready") next; if (index($NF,prefix)!=1 || !(name in expected) || $5!=expected\133name\135) bad=1; seen\133name\135++ } END { for (name in expected) if (seen\133name\135!=1) bad=1; if (count==0 || bad) exit 1 }')" "$taf_g_root/taffish-resource.files" - || taf_g_fail 'resource member inventory/size mismatch'; printf -- '--volume=%s:/refdata:ro' "$taf_g_root")][apptainer: $(taf_g_fail() { printf >&2 'taf-gtdbtk: %s\n' "$1"; printf -- '--taffish-gtdbtk-invalid-db'; exit 0; }; taf_g_auto="${TAFFISH_GTDBTK_AUTO_MOUNT:-1}"; test "$taf_g_auto" != 0 || exit 0; test "$taf_g_auto" = 1 || taf_g_fail 'TAFFISH_GTDBTK_AUTO_MOUNT must be 0 or 1'; taf_g_root="${TAFFISH_GTDBTK_DATA_PATH:-}"; if test "${TAFFISH_GTDBTK_DATA_PATH+x}" != x; then for taf_g_try in "${HOME:-}/.local/share/taffish/databases/gtdbtk/r232" /usr/local/share/taffish/databases/gtdbtk/r232 /opt/taffish/databases/gtdbtk/r232; do if test -e "$taf_g_try" || test -L "$taf_g_try"; then taf_g_root="$taf_g_try"; break; fi; done; fi; if test -z "$taf_g_root" && test "${TAFFISH_GTDBTK_DATA_PATH+x}" != x; then exit 0; fi; test -n "$taf_g_root" && test -d "$taf_g_root" || taf_g_fail 'missing database root; choose a prepared TAFFISH_GTDBTK_DATA_PATH'; taf_g_root="$(cd "$taf_g_root" && pwd -P)" || taf_g_fail 'cannot resolve database root'; test "$(printf '%s' "$taf_g_root" | tr -d ' \011\012\013\014\015\052\054\072\077\133\135')" = "$taf_g_root" || taf_g_fail 'bind path contains whitespace/reserved characters; use manual bind'; for taf_g_name in taffish-resource.json taffish-resource.files taffish-resource.ready; do test -s "$taf_g_root/$taf_g_name" && test ! -L "$taf_g_root/$taf_g_name" || taf_g_fail 'missing manifest/inventory/READY'; done; taf_g_hash() { if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1"; else shasum -a 256 "$1"; fi; }; taf_g_a="$(taf_g_hash "$taf_g_root/taffish-resource.json")" || taf_g_fail 'SHA256 tool failed'; taf_g_b="$(taf_g_hash "$taf_g_root/taffish-resource.files")" || taf_g_fail 'SHA256 tool failed'; test "${taf_g_a%% *} ${taf_g_b%% *}" = "$(cat "$taf_g_root/taffish-resource.ready")" || taf_g_fail 'READY checksum mismatch'; grep -F '"md5": "25a59e0352b1fd150c589f56559767d4"' "$taf_g_root/taffish-resource.json" >/dev/null || taf_g_fail 'wrong R232 identity'; test -z "$(find "$taf_g_root" -type l -print)" || taf_g_fail 'resource contains a symlink'; test -z "$(find "$taf_g_root" -perm -002 -o -perm -020)" || taf_g_fail 'resource must not be group/world writable'; find "$taf_g_root" -type f -exec ls -ln {} + | LC_ALL=C awk -v prefix="$taf_g_root/" "$(printf '%b' 'FILENAME != "-" { if (NF != 2 || $1 !~ /^\1330-9\135+$/ || $2 ~ /^\\// || $2 ~ /\\.\\./ || $2 !~ /^\133A-Za-z0-9_.+\\/-\135+$/ || ($2 in expected)) bad=1; expected\133$2\135=$1; count++; next } { name=substr($NF,length(prefix)+1); if (name=="taffish-resource.json" || name=="taffish-resource.files" || name=="taffish-resource.ready") next; if (index($NF,prefix)!=1 || !(name in expected) || $5!=expected\133name\135) bad=1; seen\133name\135++ } END { for (name in expected) if (seen\133name\135!=1) bad=1; if (count==0 || bad) exit 1 }')" "$taf_g_root/taffish-resource.files" - || taf_g_fail 'resource member inventory/size mismatch'; printf -- '--bind=%s:/refdata:ro' "$taf_g_root")]>
gtdbtk ::*ARGV*::
